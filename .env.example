# AI Campus Opportunity Agent - Environment Configuration

# Flask Core Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=campus_ai_agent_secure_key_prod_dev_9921
PORT=5000

# OpenRouter AI Model Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/api/auth/google/callback

# SMS / WhatsApp Notification Gateway
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email SMTP Notification Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Background Scheduler Scan Intervals (in hours)
INTERNSHIP_SCAN_HOURS=6
SCHOLARSHIP_SCAN_HOURS=12
EVENT_SCAN_HOURS=6
DEADLINE_CHECK_HOURS=1
